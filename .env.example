# ========== OpenHub Config ==========
PORT=3000
NODE_ENV=development

# Repo root (where local git repos live)
OPENHUB_REPOS_ROOT=%USERPROFILE%/Documents/openhub/repos

# Session secret for express-session
SESSION_SECRET=change-me-to-a-random-secret-string

# ========== Local LLM (Ollama) ==========
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ========== Remote API Providers ==========
# At least one API provider required for complex tasks
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ========== GitHub Integration ==========
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ========== Auth hardening ==========
# JWT signing secrets. If unset, a persistent fallback key file is generated at
# OPENHUB_KEY_DIR/emergency-keys.json (default ~/.openhub/). Set these in production.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
OPENHUB_KEY_DIR=

# Credentialed cross-origin allowlist (comma-separated). Defaults to localhost.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ========== SSO (OIDC) + SCIM provisioning ==========
# SSO is enabled only when OIDC_ISSUER + OIDC_CLIENT_ID + OIDC_CLIENT_SECRET are
# all set. Authorization Code + PKCE; ID token verified against the IdP JWKS.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=            # default <APP_URL>/api/auth/sso/callback
OIDC_SCOPE=openid email profile
OIDC_GROUP_CLAIM=groups       # claim carrying group membership
OIDC_GROUP_ROLE_MAP=          # JSON, e.g. {"devs":"developer","admins":"admin"}
OIDC_DEFAULT_ROLE=member
# SCIM 2.0 user provisioning. Unset = the /scim/v2 endpoints return 503.
SCIM_BEARER_TOKEN=
# Optional seat cap. When reached, SCIM user creation is refused (403).
OPENHUB_MAX_SEATS=

# Development-only backdoors. Leave disabled in production.
# SEED_DEMO_ACCOUNTS=1 creates demo accounts with a known password.
# ALLOW_QUICK_ACCESS=1 enables the unauthenticated /api/auth/quick-access endpoint.
SEED_DEMO_ACCOUNTS=0
ALLOW_QUICK_ACCESS=0

# ========== Ecosystem awareness (Overlay365 fleet) ==========
# Root of the fleet operating rules (layer files under rules/overlay365/).
# Plus optional overrides for the fleet catalog + .draymond brain state.
OPENHUB_ECOSYSTEM_ROOT=
# Additional intel sources, `;`-delimited (`:` is illegal — Windows paths
# contain it). Each root is scanned for canonical layout content plus
# scattered SKILL.md / AGENTS.md / docs / plans. Secrets and caches
# (Keywire, .env, node_modules, .git) are never indexed.
# Example: OPENHUB_ECOSYSTEM_ROOTS=C:/Ecosystem;C:/Uplift;C:/recourse
OPENHUB_ECOSYSTEM_ROOTS=
OPENHUB_FLEET_CATALOG=
OPENHUB_DRAYMOND_DIR=

# Agent role registry — which on-disk agents back the audit system and the
# research pipeline. `;`-delimited absolute paths. When unset, defaults derive
# from UPLIFT_ROOT (each backs a live scorer, so the roster reports present):
#   audit:    Draymond-Orchestrator/agents/CodeNexus-main, The Deep,
#             Draymond-Orchestrator/agents/Claw-Protect-main,
#             Draymond-Orchestrator/agents/deterministic-brain,
#             Draymond-Orchestrator/agents/Grader-main
#   research: Draymond-Orchestrator/agents/OmniResearch-Pro-main,
#             Draymond-Orchestrator/agents/AgentBrowser-main
OPENHUB_AUDIT_AGENTS=
OPENHUB_RESEARCH_AGENTS=

# ========== Fleet LLM routing (capability #4) ==========
# Server-side AI routes (e.g. PR review) call the fleet's provider seam.
OPENHUB_LLM_BASE_URL=http://localhost:4100
OPENHUB_LLM_MODEL=fleet-free
OPENHUB_LLM_KEY=
OPENHUB_LLM_FALLBACKS=
# Model used by the fallback base URLs (defaults to OPENHUB_LLM_MODEL). Lets a
# local primary fall back to a differently-named API group. Local-first example:
#   OPENHUB_LLM_BASE_URL=http://127.0.0.1:8000
#   OPENHUB_LLM_MODEL=olmoe
#   OPENHUB_LLM_KEY=local
#   OPENHUB_LLM_FALLBACKS=http://localhost:4100
#   OPENHUB_LLM_FALLBACK_MODEL=fleet-free
OPENHUB_LLM_FALLBACK_MODEL=

# ========== Keywire zero-trust secrets (capability #6) ==========
OPENHUB_KEYWIRE_URL=
OPENHUB_KEYWIRE_TOKEN=
# Vault scope for secret reads + business records (compliance). Defaults to the
# Overlay365 LLC project once Keywire is on loopback.
OPENHUB_KEYWIRE_PROJECT=
OPENHUB_KEYWIRE_ENV=
# Keywire's shared HMAC secret file (jwtSecret). When unset, OpenHub looks for
# <UPLIFT_ROOT>/Keywire/data/keywire-keys.json, then ~/Downloads/Uplift/Keywire/...
# and signs a short-lived SVID — no service token required.
OPENHUB_KEYWIRE_KEYS_FILE=
# File holding a minted vault JWT or `kw_st_live_*` service token.
OPENHUB_KEYWIRE_TOKEN_FILE=
# (Key dir lives in the Auth hardening section above as OPENHUB_KEY_DIR —
# intentionally not duplicated here; dotenv would silently take the last value.)
# Optional per-secret env: OPENHUB_SECRET_<NAME> takes precedence over Keywire/file.

# ========== AgentBrowser (authenticated provider access) ==========
# When a provider's secret is blank/placeholder, OpenHub reaches the provider's
# dashboard through AgentBrowser's live (real Comet profile) session instead of
# a guessed key. The AgentBrowser credential itself resolves from Keywire
# (AGENTBROWSER_API_KEY); AGENTBROWSER_URL is the non-secret base and may be set
# here or in the vault. Leave blank to use http://127.0.0.1:3700.
OPENHUB_AGENTBROWSER_URL=

# ========== Deterministic reports + local channel (Open-Chat) ==========
# OpenHub hosts an ntfy-compatible channel so Open-Chat (Draymond/Hermes/you)
# share one local-first message bus — no third-party server.
# Subscribe in Open-Chat: protocol "ntfy", host `http://127.0.0.1:<openhub-port>/ntfy`,
# topic `openhub-reports`.
OPENHUB_CHANNEL_DIR=
# Optional bearer token required on /ntfy publish + subscribe (recommended if
# OpenHub is not loopback-only). Open-Chat sends it as the bot's token.
OPENHUB_NTFY_TOKEN=

# ========== Fleet catalog + agent dispatch (capability #3) ==========
# Path to a gsd CLI for real agent dispatch (else the endpoint returns 501).
OPENHUB_GSD_CLI=

# ========== CRM action dispatch (deterministic brain primary) ==========
# Primary: POST {OPENHUB_BRAIN_URL}/task { query, lane_override? } (zero-LLM loop).
OPENHUB_BRAIN_URL=http://127.0.0.1:3210
# Fallback: Uplift-Agent bridge POST {URL}/task { description } -> 202 queued.
# Intentionally unset by default: fleet docs name :8000, but that port serves the
# colibri local LLM here, so the fallback only fires when explicitly configured.
OPENHUB_UPLIFT_AGENT_URL=
# Set OPENHUB_DISPATCH_FALLBACK=0 to disable the fallback chain entirely.

# ========== Fleet GitHub repo awareness (ncsound919 + tap919) ==========
# Bearer token for the authenticated account (private repos + rate limits).
# Resolved via Keywire/env/file (resolveSecret('GITHUB_TOKEN')).
GITHUB_TOKEN=
# Optional API base override (default https://api.github.com; tests use a mock).
OPENHUB_GITHUB_API_BASE=

# ========== Recourse (self-developing architectural OS) ==========
# OpenHub proxies Recourse's self-learning memory, registry, forge, learner and
# provenance surface under /api/recourse/*. RECOURSE_API_SECRET is Recourse's
# mutation secret; without it guarded writes (fleet-memory intake, scan-heal,
# forge, self-hosted execute) fail closed honestly.
RECOURSE_URL=http://localhost:3050
RECOURSE_API_SECRET=

# ========== Unified telemetry + insights ==========
# Append-only cross-system event stream (JSONL). Defaults to <openhub>/data/telemetry.
# Feed by incidents, supervisor runs and the Recourse bridge.
OPENHUB_TELEMETRY_DIR=
# Rotate the stream once it exceeds this many bytes (default 5 MiB).
OPENHUB_TELEMETRY_MAX_BYTES=

# ========== Autonomy engine (self-driving heartbeat) ==========
# The server probes managed services, resumes supervised runs and recomputes
# insights on an interval, streaming a snapshot to the UI (no manual refresh).
# 0 = disable the heartbeat.
OPENHUB_AUTONOMY=
# Tick interval in ms (default 30000).
OPENHUB_AUTONOMY_INTERVAL_MS=
# Snapshot persistence dir (default <openhub>/data/autonomy).
OPENHUB_AUTONOMY_DIR=

# ========== Self-learning (OpenHub's own learner) ==========
# Episodes -> skill effectiveness -> lessons -> calibrated pass-rate bar.
# Feeds evidence-based skill selection into supervised runs. Default <openhub>/data/self-learning.
OPENHUB_SELFLEARNING_DIR=
# Rotate the episode log once it exceeds this many bytes (default 5 MiB).
OPENHUB_SELFLEARNING_MAX_BYTES=

# ========== Audit suite: The Deep / CodeGang / CodeNexus / Benchmark Olympics QA ==========
# The Deep HTTP server for the `deep` scorer (same convention as Axiom). Unset = honest skip.
DEEP_URL=
# CodeGang Next dev server (local repoPath analysis) for the `codegang` scorer.
CODEGANG_URL=http://127.0.0.1:3011
# CodeNexus control plane (GitHub-webhook PR review; no local-dir endpoint).
CODENEXUS_URL=http://127.0.0.1:3205
# Bound for the Benchmark Olympics local-QA gate (`local_qa` runs the target's own tests).
LOCAL_QA_TIMEOUT_MS=120000

# ========== Shared audit core (config / rules / validator / lifecycle / autofix) ==========
# Repo config file: `openhub.yaml` (or `.openhub.yaml` / `audit.config.yaml`) at the
# repo root — plain-English rules, path_instructions, tool toggles and the PR/release gate.
# Per-repo lifecycle records persist here (default <repo>/.openhub/audit-lifecycle.json).
OPENHUB_CORE_STATE_DIR=
# The rules engine and autofix reuse the fleet LLM routing above
# (OPENHUB_LLM_BASE_URL / OPENHUB_LLM_MODEL / OPENHUB_LLM_KEY). When no LLM is
# configured those endpoints report configured:false — never a faked result.

# ========== Audit: recursive-learning feedback (opt-in) ==========
# Emit one telemetry event + one self-learning episode per audit run so trends
# and Recourse's loop can learn from audit outcomes. Off unless set to 1/true/yes.
AUDIT_FEEDBACK=
# Runtime result cache for repeat audits (content-signature keyed). 0 = disabled.
AUDIT_CACHE_TTL_MS=0
# Pin the LLM model id + seed (recorded on every report, forwarded to The Deep).
AUDIT_LLM_MODEL=
AUDIT_LLM_SEED=
# Max changed files before a diff-scoped audit falls back to a full audit.
AUDIT_MAX_DIFF_FILES=500
# Where the audit snapshot is written for Recourse's reporter.
AUDIT_SNAPSHOT_PATH=

# ========== Audit suite: SonarQube / reviewdog / PR-Agent ==========
# SonarQube Community Build server + token for the `sonarqube` scorer. The
# project must already have been analyzed on the server; unset = honest skip.
# Internal team use only (bundled analyzers are Sonar's Source-Available License).
SONAR_URL=
SONAR_TOKEN=
# Analyzed SonarQube project key (falls back to the target package.json name).
SONAR_PROJECT_KEY=
# 0 = never run a fresh scan (read the last server analysis only). Default 1:
# when a local target exists the `sonarqube` scorer runs sonar-scanner so the
# gate reflects the current tree, then polls the server until done.
SONAR_SCAN=
# sonar-scanner binary (must be on PATH when SONAR_SCAN is on).
SONAR_SCANNER_CMD=
# Scanner process timeout (default 600000) and Compute Engine poll timeout (default 300000).
SONAR_SCAN_TIMEOUT_MS=
SONAR_CE_POLL_TIMEOUT_MS=
# reviewdog binary used by the `openhub_reviewdog_rdjson` MCP tool for
# diff-scoped PR annotations. Unset = the tool still returns rdjson to pipe.
REVIEWDOG_CMD=
# PR-Agent (Qodo) CLI invoked by the `openhub_pr_agent_review` MCP tool. Output
# is narrative only and is never scored. Unset = honest "not configured".
PR_AGENT_CMD=

# ========== SEO engine (open-seo, self-hosted) ==========
# Fleet service (agents/open-seo, docker compose, port 3001). OpenHub reads its
# /api/health for setup truth and runs its own free deterministic site audit.
# Keyword/backlink/rank data needs DATAFORSEO_API_KEY in the vault.
OPENHUB_OPENSEO_URL=http://127.0.0.1:3001

# ========== Bot chat endpoint (Open-Chat) ==========
# OpenAI-compatible POST /v1/chat/completions for external bot clients that
# cannot use the browser cookie+CSRF auth. Send 'Authorization: Bearer <token>'.
# Fail-closed: the endpoint returns 401 unless this is set.
OPENHUB_CHAT_TOKEN=
