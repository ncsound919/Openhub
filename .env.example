# ========== OpenHub Config ==========
PORT=3000
NODE_ENV=development

# Repo root (where local git repos live)
OPENHUB_REPOS_ROOT=%USERPROFILE%/Documents/openhub/repos

# Session secret for express-session
SESSION_SECRET=change-me-to-a-random-secret-string

# ========== Local LLM (Ollama) ==========
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ========== Remote API Providers ==========
# At least one API provider required for complex tasks
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ========== GitHub Integration ==========
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ========== VibeServe MCP ==========
VIBESERVE_WORKSPACE=.
PYTHONPATH=vibeserve
