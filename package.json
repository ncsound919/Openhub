{
  "name": "openhub",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:all": "concurrently --no-kill-others -n \"express,orchestrator,mcp\" -c \"green,yellow,magenta\" \"tsx server.ts\" \"tsx orchestrator/index.ts\" \"python -m vibeserve\"",
    "dev:test": "cross-env E2E_FAST_PIPELINE=1 tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --outdir=dist",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "electron:dev": "cross-env NODE_ENV=development concurrently \"tsx server.ts\" \"wait-on http://localhost:3000 && electron .\"",
    "start": "node server.ts",
    "mcp:install": "pip install -e vibeserve/.",
    "mcp:test": "pytest vibeserve/tests/ -v",
    "db:init": "node -e \"require('./src/auth/db.ts').initializeDatabase()\"",
    "test": "vitest run && playwright test",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@google/genai": "^1.51.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.100.6",
    "@vitejs/plugin-react": "^5.0.4",
    "awesome-node-auth": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.74.0",
    "react-router-dom": "^7.15.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.1",
    "simple-git": "^3.27.0",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.0",
    "vite": "^6.2.3",
    "ws": "^8.18.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zod": "^4.4.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "esbuild": "^0.28.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.6",
    "wait-on": "^9.0.10"
  }
}
